# Origin the browser / Next rewrite calls. No path, no trailing slash.
# Local Java: http://localhost:8080
# Stand: https://… — add this app's origin to app.corsOrigins when calling Java directly.
JAVA_API_BASE_URL=http://localhost:8080

# Local CORS bypass: Next rewrites /api/v1/* → JAVA_API_BASE_URL (same-origin fetch).
# OAuth (Yandex) still opens JAVA_API_BASE_URL directly. Not used for GitHub Pages export.
# Set to 1 for npm run dev against a stand that lacks working browser CORS.
JAVA_API_PROXY=1

# Shown as a mailto in the support header. Leave empty until the address exists.
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=

# TELEGRAM_BOT_TOKEN and TELEGRAM_SUPPORT_CHAT_ID belong on the Java backend only.
# See docs/intent/telegram-env.md — do not put them in this frontend .env.
